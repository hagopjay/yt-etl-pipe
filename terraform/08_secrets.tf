############################################
# 08_secrets.tf
#
# Two secrets:
#   proxy_credentials  -- Webshare rotating-residential-proxy username/
#                         password. See docs/ARCHITECTURE_INSIGHTS.md
#                         "Why a proxy is not optional" -- Lambda's AWS
#                         IPs are reliably blocked by YouTube's caption
#                         endpoints without one.
#   review_hmac_key    -- signs the approve/reject links emailed to a
#                         human reviewer, so a leaked/forwarded email
#                         can't be used to approve a DIFFERENT review by
#                         editing the URL's review_id.
#
# Terraform creates the secret CONTAINER only, with a placeholder value.
# The real values are set out-of-band (`aws secretsmanager put-secret-value`
# or via the console) so that credentials never pass through Terraform
# state or a CI log -- state files are not a safe place for live secrets
# even though this provider CAN write them there.
############################################

resource "aws_secretsmanager_secret" "proxy_credentials" {
  name = "${var.project_name}/webshare-proxy-credentials"
}

resource "aws_secretsmanager_secret_version" "proxy_credentials_placeholder" {
  secret_id = aws_secretsmanager_secret.proxy_credentials.id
  secret_string = jsonencode({
    proxy_username = "REPLACE-VIA-CLI-NOT-TERRAFORM"
    proxy_password = "REPLACE-VIA-CLI-NOT-TERRAFORM"
  })

  lifecycle {
    ignore_changes = [secret_string] # once set out-of-band, never let a future `apply` stomp the real value with this placeholder
  }
}

resource "aws_secretsmanager_secret" "review_hmac_key" {
  name = "${var.project_name}/review-hmac-signing-key"
}

resource "random_id" "review_hmac_seed" {
  byte_length = 32
}

resource "aws_secretsmanager_secret_version" "review_hmac_key" {
  secret_id     = aws_secretsmanager_secret.review_hmac_key.id
  secret_string = random_id.review_hmac_seed.hex
  # Generated by Terraform itself is fine here (unlike the proxy creds) --
  # this key has no meaning outside this system, so Terraform owning its
  # lifecycle (including rotation via `terraform taint`) is the simpler,
  # correct choice.
}
